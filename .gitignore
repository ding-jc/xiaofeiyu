# ── 依赖与构建产物 ──────────────────────────────────────────────
node_modules/
dist/
dist-portable/
src-tauri/target/
src-tauri/gen/

# ── 角色素材：113MB，按需 `npm run assets` 拉取（见 THIRD_PARTY_NOTICES）──
# 目录本身必须留在仓库里：tauri.conf.json 把 resources/characters 声明成固定
# resource 路径，目录不存在会让 tauri-build 直接失败（CI 无素材时打不出包）。
# 音效只有几十 KB 且是内置功能依赖，入库。
src-tauri/resources/characters/*
!src-tauri/resources/characters/.gitkeep

# ── 本地调试 / 临时产物 ─────────────────────────────────────────
.dbg/
.vite/
dist-assets/
src-tauri/resources/characters.incoming/
*.log
check.log
tree.json
crates.json
wp-readme.md
.research/
*.tmp

